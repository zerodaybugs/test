#!/usr/bin/env python3
"""Read-only TermMax V2 vault asset / order debt-token consistency census.

Discovers current V2 vaults through official factory events, known public vault
addresses and the public DefiLlama pool index. For every NewOrderCreated event,
reads the vault asset and the market debt token and records mismatches.

Safety: public eth_call and indexed HTTPS GET requests only. No private key,
signer, transaction construction, fork mutation or broadcast capability.
"""
from __future__ import annotations

import json
import os
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import requests
from web3 import Web3
from web3.middleware import ExtraDataToPOAMiddleware

