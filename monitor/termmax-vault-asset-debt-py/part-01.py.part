def safe(fn, *args, **kwargs) -> dict[str, Any]:
    try:
        v = fn(*args, **kwargs)
        return {"ok": True, "value": list(v) if isinstance(v, tuple) else v}
    except Exception as exc:  # noqa: BLE001
        return {"ok": False, "error": f"{type(exc).__name__}: {exc}"}


def value(r: Any, default: Any = None) -> Any:
    return r.get("value", default) if isinstance(r, dict) and r.get("ok") else default


def connect() -> tuple[Web3, str, list[dict[str, Any]]]:
    attempts = []
    env = os.environ.get(f"{CHAIN.upper()}_RPC_URL", "").strip()
    for url in [env, *CFG["rpcs"]]:
        if not url:
            continue
