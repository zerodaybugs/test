        try:
            w3 = Web3(Web3.HTTPProvider(url, request_kwargs={"timeout": 40}))
            if CFG.get("poa"):
                w3.middleware_onion.inject(ExtraDataToPOAMiddleware, layer=0)
            cid, latest = w3.eth.chain_id, w3.eth.block_number
            block = w3.eth.get_block(latest)
            if cid != CFG["chainId"]:
                raise RuntimeError(f"unexpected chain id {cid}")
            attempts.append({"url":url,"ok":True,"block":latest,"hash":block.hash.hex()})
            return w3, url, attempts
        except Exception as exc:  # noqa: BLE001
            attempts.append({"url":url,"ok":False,"error":f"{type(exc).__name__}: {exc}"})
    raise RuntimeError(json.dumps(attempts))


def topic_address(topic: str) -> str:
    s = topic[2:] if topic.startswith("0x") else topic
    return Web3.to_checksum_address("0x" + s[-40:])


def routescan_logs(address: str, topic0: str, latest: int, topic1: str | None = None) -> list[dict[str, Any]]:
    url = f"https://api.routescan.io/v2/network/mainnet/evm/{CFG['routescanId']}/etherscan/api"
    out: list[dict[str, Any]] = []
    page = 1
    while True:
        params: dict[str, Any] = {
            "module":"logs","action":"getLogs","address":address,"fromBlock":0,"toBlock":latest,
            "topic0":topic0,"page":page,"offset":1000,
        }
        if topic1:
            params.update({"topic1":topic1,"topic0_1_opr":"and"})
        payload = None
        last = None
        for attempt in range(7):
            try:
                r = requests.get(url, params=params, timeout=60, headers={"User-Agent":"ZeroDayBugs-TermMax-Readonly/1"})
                if r.status_code == 429:
                    time.sleep(2 * (attempt + 1)); continue
                r.raise_for_status(); payload = r.json(); break
            except Exception as exc:  # noqa: BLE001
                last = exc; time.sleep(1.25 * (attempt + 1))
        if payload is None:
            raise RuntimeError(f"routescan failed {address}: {last}")
        rows = payload.get("result", []) if isinstance(payload, dict) else []
        if isinstance(rows, str):
            if "no" in rows.lower() or "not found" in rows.lower():
                break
            raise RuntimeError(f"unexpected routescan result: {payload}")
        if not rows:
            break
        out.extend(rows)
        if len(rows) < 1000:
            break
        page += 1
    return out


def rpc_logs(w3: Web3, address: str, topic0: str, latest: int) -> list[Any]:
    out = []
    cursor = 0
    sizes = [100_000,20_000,5_000,1_000]
    idx = 0
    while cursor <= latest:
        end = min(latest, cursor + sizes[idx] - 1)
        try:
            out.extend(w3.eth.get_logs({"address":address,"fromBlock":cursor,"toBlock":end,"topics":[topic0]}))
            cursor = end + 1; idx = 0
        except Exception:
            if idx + 1 >= len(sizes):
                raise
            idx += 1
    return out


