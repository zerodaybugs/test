  "standardFormula": {
    "allowedAuthenticationNames": [
      "defaultUserAuthentication"
    ],
    "autocompletePresent": true
  },
  "syncFormula": {
    "allowedAuthenticationNames": [
      "defaultUserAuthentication"
    ],
