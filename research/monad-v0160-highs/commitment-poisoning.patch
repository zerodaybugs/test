+    fn sub_be_32(a: &[u8; 32], b: &[u8; 32]) -> [u8; 32] {
+        let mut out = [0u8; 32];
+        let mut borrow = 0u16;
+        for i in (0..32).rev() {
+            let ai = a[i] as u16;
+            let bi = b[i] as u16 + borrow;
+            if ai >= bi {
+                out[i] = (ai - bi) as u8;
+                borrow = 0;
+            } else {
+                out[i] = (ai + 256 - bi) as u8;
+                borrow = 1;
+            }
+        }
+        assert_eq!(borrow, 0);
+        out
+    }
+
+    #[test]
+    fn recoverable_high_s_alias_poisoning_rejects_authentic_commitment() {
+        use monad_crypto::{
+            certificate_signature::{CertificateKeyPair, CertificateSignatureRecoverable},
+            signing_domain,
+        };
+        use monad_secp::{KeyPair, PubKey as SecpPubKey, SecpSignature};
+
+        let mut secret = [0x42u8; 32];
+        let key = KeyPair::from_bytes(&mut secret).expect("valid key");
+        let msg = b"deterministic raptorcast signed header";
+        let original = key.sign::<signing_domain::RaptorcastChunk>(msg);
+        let original_bytes = original.serialize();
+
+        let mut alias_bytes = original_bytes;
+        let mut low_s = [0u8; 32];
+        low_s.copy_from_slice(&original_bytes[32..64]);
+        alias_bytes[32..64]
+            .copy_from_slice(&sub_be_32(&[0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xfe,0xba,0xae,0xdc,0xe6,0xaf,0x48,0xa0,0x3b,0xbf,0xd2,0x5e,0x8c,0xd0,0x36,0x41,0x41], &low_s));
+        alias_bytes[64] ^= 1;
+        let alias = SecpSignature::deserialize(&alias_bytes).expect("alias parses");
+
+        let original_author = original
+            .recover_pubkey::<signing_domain::RaptorcastChunk>(msg)
+            .expect("original recovers");
+        let alias_author = alias
+            .recover_pubkey::<signing_domain::RaptorcastChunk>(msg)
+            .expect("alias recovers");
+        assert_eq!(original_author, alias_author);
+        assert_eq!(original_author, key.pubkey());
+        assert_ne!(original_bytes, alias_bytes);
+
+        let mk = |signature: &[u8; SIGNATURE_SIZE]| ValidatedChunk::<SecpPubKey> {
+            chunk: Bytes::new(),
+            message: Bytes::new(),
+            signature: Bytes::copy_from_slice(signature),
+            author: NodeId::new(original_author),
+            group_id: GroupId::Primary(monad_types::Epoch(1)),
+            unix_ts_ms: 1,
+            app_message_hash: None,
+            app_message_len: 1,
+            recipient_hash: None,
+            chunk_id: 0,
+            version: ChunkVersion::V1,
+            num_source_symbols: 1,
+            encoded_symbol_capacity: 1,
+            encoding_scheme: EncodingScheme::Deterministic25(Round(42)),
+            broadcast_mode: BroadcastMode::Primary,
+            merkle_root: MERKLE_A,
+        };
+
+        let alias_chunk = mk(&alias_bytes);
+        let authentic_chunk = mk(&original_bytes);
+        let mut info = PrimaryRoundInfo::<SecpPubKey>::default();
+
+        assert!(info.try_commit(&alias_chunk).is_some());
+        assert!(
+            info.try_commit(&authentic_chunk).is_none(),
+            "a malleated-but-valid first signature poisons the round commitment"
+        );
+    }
+
+ }
