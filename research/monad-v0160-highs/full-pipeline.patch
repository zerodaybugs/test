+    fn malleate_recoverable_signature(payload: &Bytes) -> Bytes {
+        use bytes::BytesMut;
+        let mut out = BytesMut::from(payload.as_ref());
+        assert!(out.len() >= crate::SIGNATURE_SIZE);
+        let mut low_s = [0u8; 32];
+        low_s.copy_from_slice(&out[32..64]);
+        let high_s = sub_be_32_high_s(&[0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xfe,0xba,0xae,0xdc,0xe6,0xaf,0x48,0xa0,0x3b,0xbf,0xd2,0x5e,0x8c,0xd0,0x36,0x41,0x41], &low_s);
+        out[32..64].copy_from_slice(&high_s);
+        out[64] ^= 1;
+        out.freeze()
+    }
