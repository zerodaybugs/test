+    fn sub_be_32_high_s(a: &[u8; 32], b: &[u8; 32]) -> [u8; 32] {
+        let mut out = [0u8; 32];
+        let mut borrow = 0u16;
+        for i in (0..32).rev() {
+            let ai = a[i] as u16;
+            let bi = b[i] as u16 + borrow;
+            if ai >= bi {
+                out[i] = (ai - bi) as u8;
+                borrow = 0;
+            } else {
+                out[i] = (ai + 256 - bi) as u8;
+                borrow = 1;
+            }
+        }
+        assert_eq!(borrow, 0);
+        out
+    }
