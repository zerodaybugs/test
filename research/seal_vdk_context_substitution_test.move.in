
#[test]
fun test_vdk_public_key_context_substitution_bypasses_threshold_binding() {
    use sui::bls12381::g1_from_bytes;

    // Generated by the exact Seal CLI using ONE attacker-controlled master key,
    // the same attacker public key three times, three distinct service IDs, and
    // threshold = 3. The plaintext is ASCII "FORGED".
    let encrypted_object = x"__ENCRYPTED_OBJECT_HEX__";
    let parsed = parse_encrypted_object(encrypted_object);

    let attacker_pk =
        x"a58bfa576a8efe2e2730bc664b3dbe70257d8e35106e4af7353d007dba092d722314a0aeb6bca5eed735466bbf471aef01e4da8d2efac13112c51d1411f6992b8604656ea2cf6a33ec10ce8468de20e1d7ecbfed8688a281d462f72a41602161";
    let honest_pk_1 =
        x"a9ce55cfa7009c3116ea29341151f3c40809b816f4ad29baa4f95c1bb23085ef02a46cf1ae5bd570d99b0c6e9faf525306224609300b09e422ae2722a17d2a969777d53db7b52092e4d12014da84bffb1e845c2510e26b3c259ede9e42603cd6";
    let honest_pk_2 =
        x"93b3220f4f3a46fb33074b590cda666c0ebc75c7157d2e6492c62b4aebc452c29f581361a836d1abcbe1386268a5685103d12dec04aadccaebfa46d4c92e2f2c0381b52d6f2474490d02280a9e9d8c889a3fce2753055e06033f39af86676651";
    let attacker_usk = g1_from_bytes(&x"__USER_SECRET_KEY_HEX__");

    // The attacker supplies the same public key and same derived key three times,
    // but labels them with three distinct honest service IDs. verify_derived_keys
    // verifies the group relation, then stores only the caller-selected ID.
    let attacker_verification_context = vector[
        new_public_key(parsed.services[0].to_id(), attacker_pk),
        new_public_key(parsed.services[1].to_id(), attacker_pk),
        new_public_key(parsed.services[2].to_id(), attacker_pk),
    ];
    let vdks = verify_derived_keys(
        &vector[attacker_usk, attacker_usk, attacker_usk],
        parsed.package_id,
        parsed.id,
        &attacker_verification_context,
    );

    // The consuming application supplies the public-key mapping it considers
    // authoritative. Only service 0 matches the attacker's key; services 1 and 2
    // are deliberately different valid BLS public keys.
    let honest_decrypt_context = vector[
        new_public_key(parsed.services[0].to_id(), attacker_pk),
        new_public_key(parsed.services[1].to_id(), honest_pk_1),
        new_public_key(parsed.services[2].to_id(), honest_pk_2),
    ];

    let gid = hash_to_g1_with_dst(&create_full_id(parsed.package_id, parsed.id));
    assert!(verify_derived_key(&vdks[0].derived_key, &gid, &honest_decrypt_context[0].pk));
    assert!(!verify_derived_key(&vdks[1].derived_key, &gid, &honest_decrypt_context[1].pk));
    assert!(!verify_derived_key(&vdks[2].derived_key, &gid, &honest_decrypt_context[2].pk));

    // All service positions are considered supplied by VDKs, so decrypt never
    // uses honest_decrypt_context[*].pk and accepts the forged threshold context.
    let plaintext = decrypt(&parsed, &vdks, &honest_decrypt_context).destroy_some();
    assert_eq!(plaintext, b"FORGED");
}
