        "ConnectorFrozen(bytes32)",
        "AccessControlUnauthorizedAccount(address,bytes32)",
    ]
}


def cs(value: str | None) -> str | None:
    return Web3.to_checksum_address(value) if value else None


def sel(signature: str) -> bytes:
    return Web3.keccak(text=signature)[:4]


def cdata(signature: str, types: list[str] | None = None, values: list[Any] | None = None) -> str:
    raw = sel(signature)
    if types:
        raw += encode(types, values or [])
    return "0x" + raw.hex()


def jnorm(value: Any) -> Any:
    if isinstance(value, bytes):
        return "0x" + value.hex()
    if isinstance(value, tuple):
        return [jnorm(v) for v in value]
    if isinstance(value, list):
        return [jnorm(v) for v in value]
    if isinstance(value, dict):
        return {str(k): jnorm(v) for k, v in value.items()}
    return value
