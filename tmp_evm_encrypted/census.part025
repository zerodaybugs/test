
# Fallback for liveness signals on networks not indexed by the configured
# Routescan endpoint. Broad manager-role history is intentionally limited to
# Ethereum, where the current material orphan signal exists; every registry on
# every chain still receives the live unprivileged mutation eth_call gate.
_routescan_logs = logs
_routescan_role_history = role_history


def logs(chain: int, address: str, topic0: str | None = None, topic1: str | None = None, max_pages: int = 100) -> list[dict[str, Any]]:
    try:
        return _routescan_logs(chain, address, topic0, topic1, max_pages)
    except RuntimeError as exc:
        if "chain not supported" not in str(exc).lower():
            raise

    network, urls = CFG[chain]
    rpc = Rpc(chain, urls)
    latest = rpc.block()
    output: list[dict[str, Any]] = []
    position = 0
    step = 1_000_000
    topics: list[Any] = []
    if topic0:
        topics.append(topic0)
    if topic1:
        if not topics:
            topics.append(None)
        topics.append(topic1)

    while position <= latest:
        stop = min(latest, position + step - 1)
        params: dict[str, Any] = {
            "address": cs(address),
            "fromBlock": hex(position),
            "toBlock": hex(stop),
        }
        if topics:
            params["topics"] = topics
        result = rpc.request("eth_getLogs", [params])
        if result.get("ok"):
            rows = result["raw"]
            if not isinstance(rows, list):
                raise RuntimeError(f"invalid eth_getLogs response on {network}: {rows}")
            output.extend(rows)
            position = stop + 1
            if len(rows) < 200 and step < 2_000_000:
                step = min(2_000_000, step * 2)
            continue
        if step > 2_000:
            step = max(2_000, step // 2)
            continue
        raise RuntimeError(
            f"eth_getLogs fallback failed on {network} for {address}: {result}"
        )
    return output


def role_history(chain: int, registry: str) -> list[dict[str, Any]]:
    if chain != 1:
        return []
    return _routescan_role_history(chain, registry)

